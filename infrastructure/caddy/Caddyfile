# FrameFound reverse proxy.
#
# Two modes, switched by FRAMEFOUND_DOMAIN:
#   - empty  -> local HTTP on :80 (behind host port mapping, default 8080)
#   - set    -> automatic HTTPS via Let's Encrypt for that domain
#
# Security invariants (do not weaken):
#   - Never serve filesystem paths directly; all media flows through the API,
#     which enforces authentication and signed URLs.
#   - Only /api/* reaches the backend; everything else goes to the web app.

# No global options block: an empty `email` directive is a parse error in
# local mode. ACME email lives in the site's `tls` directive instead, with
# placeholder defaults making the unset case valid ("localhost" + internal CA).
# TODO(m7): template this file from the remote-access wizard.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(app) {
	import security_headers
	encode gzip zstd

	# Auth endpoints get a tighter request-rate posture at the app layer;
	# body-size limit guards the whole surface.
	request_body {
		max_size 100MB
	}

	handle /api/* {
		# Nothing the API serves is a page to run: JSON, media, captions.
		# Should a stored file ever come back as HTML (the 2026-11 review
		# found a sky upload that could), it renders inert. The docs pages
		# are the exception — they need their scripts.
		@not_docs not path /api/docs* /api/redoc* /api/openapi.json
		header @not_docs Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Nobody outside may claim to have come through the tunnel: the API treats
# this header (set only by the :8081 entrance below) as "from the internet".
(not_tunnel) {
	request_header -X-FrameFound-Ingress
	request_header -X-FrameFound-Client
}

# Local / LAN / Tailscale mode
:80 {
	import not_tunnel
	import app
}

# Cloudflare Tunnel entrance. Not published on the host: only the cloudflared
# container reaches it, over the edge network. Point the tunnel's public
# hostname at http://caddy:8081 (docs/remote-access.md, Mode C). Without this
# entrance every tunnel visitor looked like a LAN client — Caddy rewrites
# X-Forwarded-For to cloudflared's private address — so the public-access
# switch did not apply to them.
:8081 {
	request_header X-FrameFound-Ingress tunnel
	request_header X-FrameFound-Client {http.request.header.Cf-Connecting-Ip}
	import app
}

# Public HTTPS mode. With FRAMEFOUND_DOMAIN unset this resolves to
# "localhost" with a self-signed internal certificate (harmless); with a real
# domain + email set, Caddy obtains Let's Encrypt certificates automatically.
{$FRAMEFOUND_DOMAIN:framefound.internal} {
	tls {$FRAMEFOUND_ACME_EMAIL:internal}
	import not_tunnel
	import app
}
