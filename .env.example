# ============================================================
# FrameFound configuration
# Copy to .env and edit. NEVER commit .env to version control.
# The installer (infrastructure/scripts/install.sh) generates
# strong random secrets for you.
# ============================================================

# ---- General ----
FRAMEFOUND_SERVER_NAME=FrameFound
TZ=America/New_York
# Path INSIDE the containers where FrameFound keeps its own data (thumbnails,
# proxies, transcripts, caches). Leave as /data.
FRAMEFOUND_DATA_DIR=/data

# WHERE that data physically lives. Unset = a Docker volume on the app disk.
# Set it to a host path to put previews and proxies on other storage — e.g. a
# NAS share — when the app disk is small. Proxies dominate this space, so
# moving them is the single biggest saving.
#   FRAMEFOUND_DATA_STORE=/mnt/framefound-data
# Requirements for a NAS path (see docs/storage.md):
#   - mounted READ-WRITE (this is a different share from your read-only media)
#   - owned by uid/gid 1000 (SMB: uid=1000,gid=1000 in fstab)
#   - _netdev,nofail so the VM still boots when the NAS is down
# The database is deliberately NOT movable this way: Postgres on a network
# share risks corruption and is slow. It stays on local disk.
# FRAMEFOUND_DATA_STORE=

# Derivative generation pauses when free space on the store drops below this,
# so a full disk can never take the database down with it.
FRAMEFOUND_MIN_FREE_GB=5

# CPU budget per media tool (0 = use all cores). Keeps background processing
# from starving the web UI on small hosts.
FRAMEFOUND_FFMPEG_THREADS=2
FRAMEFOUND_WHISPER_THREADS=3

# ---- Media libraries (originals; mount read-only) ----
# Mount your NAS shares on the HOST first, then reference them here.
# Additional libraries are added later in the web UI; this is the
# root under which all library paths must live (path allowlist).
FRAMEFOUND_MEDIA_ROOT=/mnt/media

# ---- Secrets (placeholders — installer replaces these) ----
# Generate with: openssl rand -hex 32
FRAMEFOUND_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
# One-time token printed at install; required to create the first admin.
FRAMEFOUND_SETUP_TOKEN=CHANGE_ME_generated_at_install

# ---- Database (internal; not exposed publicly) ----
POSTGRES_USER=framefound
POSTGRES_DB=framefound
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Queue (internal; not exposed publicly) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Processing ----
# cpu | cuda  (cuda requires NVIDIA Container Toolkit + docker-compose.gpu.yml)
FRAMEFOUND_COMPUTE=cpu
# faster-whisper model size: tiny | base | small | medium | large-v3
FRAMEFOUND_WHISPER_MODEL=small
# CLIP-compatible embedding model (OpenCLIP name)
FRAMEFOUND_VISION_MODEL=ViT-B-32/laion2b_s34b_b79k
# Proxy transcode target
FRAMEFOUND_PROXY_RESOLUTION=1080
FRAMEFOUND_PROXY_VIDEO_CODEC=h264
# Concurrency caps (0 = auto based on detected hardware)
FRAMEFOUND_MAX_TRANSCODE_JOBS=0
FRAMEFOUND_MAX_TRANSCRIBE_JOBS=0

# ---- Web / reverse proxy ----
# Local-only default. For public HTTPS, set your domain and email
# and Caddy obtains Let's Encrypt certificates automatically.
FRAMEFOUND_HTTP_PORT=8080
FRAMEFOUND_DOMAIN=
FRAMEFOUND_ACME_EMAIL=

# ---- Optional: Cloudflare DDNS (compose profile: ddns) ----
# Use a SCOPED API token (Zone:DNS:Edit), never the global API key.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=
CLOUDFLARE_RECORD=
FRAMEFOUND_DDNS_INTERVAL_MINUTES=5

# ---- Optional: Cloudflare Tunnel (compose profile: tunnel) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Storage (optional: drive management from the UI) ----
# Root the mount helper places network shares under. Both must exist on the
# host and be shared mounts:  sudo mkdir -p /mnt/media /mnt/cache
#                             sudo mount --make-rshared /mnt/media
#                             sudo mount --make-rshared /mnt/cache
FRAMEFOUND_CACHE_ROOT=/mnt/cache
# Long random value. Required only when running the `storage` profile, which
# starts the one privileged container in the stack.
#   docker compose --profile storage up -d
FRAMEFOUND_MOUNTER_TOKEN=
