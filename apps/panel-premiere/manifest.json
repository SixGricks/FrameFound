{
  "manifestVersion": 5,
  "id": "com.sixgricks.framefound",
  "name": "FrameFound",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "framefound.search",
      "label": { "default": "FrameFound" },
      "minimumSize": { "width": 320, "height": 400 },
      "preferredDockedSize": { "width": 380, "height": 640 },
      "preferredFloatingSize": { "width": 480, "height": 720 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "http://framefound.local:8080",
        "https://framefound.local",
        "http://192.168.1.193:8080"
      ]
    },
    "allowCodeGenerationFromStrings": false
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon-24.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light"]
    }
  ]
}
